{
  "name": "cntx",
  "version": "0.0.4",
  "description": "create and use context for async functions in node",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node --test test/*.test.cjs",
    "check": "npm run lint && npm run format:check && npm test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check",
    "preversion": "npm run check"
  },
  "keywords": [
    "async",
    "hook",
    "context",
    "async context",
    "async hook",
    "async global context"
  ],
  "author": "Amir Saboury",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amir-s/cntx.git"
  },
  "packageManager": "yarn@1.22.22",
  "homepage": "https://github.com/amir-s/cntx#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
